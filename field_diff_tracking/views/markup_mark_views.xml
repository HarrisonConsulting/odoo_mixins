<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Marks are read through the record they mark, by everyone who can open
        that record. This is the other way in: the whole table, for whoever
        maintains it. It stays behind Technical because a mark carries the text
        of the passage it quotes, and a list of every mark in the database is a
        list of passages from records its reader may never have been shown.
    -->

    <record id="view_markup_mark_list" model="ir.ui.view">
        <field name="name">markup.mark.list</field>
        <field name="model">markup.mark</field>
        <field name="arch" type="xml">
            <list string="Marks" decoration-muted="state in ('rejected', 'superseded')"
                  decoration-warning="state == 'orphaned'"
                  decoration-success="state == 'accepted'">
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="field_name"/>
                <field name="motivation"/>
                <field name="edit_kind" optional="hide"/>
                <field name="quote"/>
                <field name="body" optional="hide"/>
                <field name="author_id"/>
                <field name="author_kind" optional="hide"/>
                <field name="anchored_by" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_markup_mark_form" model="ir.ui.view">
        <field name="name">markup.mark.form</field>
        <field name="model">markup.mark</field>
        <field name="arch" type="xml">
            <form string="Mark">
                <sheet>
                    <group>
                        <group string="What it marks">
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="field_name"/>
                            <field name="version_ref"/>
                        </group>
                        <group string="Where it stands">
                            <field name="state"/>
                            <field name="anchored_by"/>
                            <field name="resolved_by_id"/>
                            <field name="resolved_on"/>
                            <field name="superseded_by_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="What it says">
                            <field name="motivation"/>
                            <field name="edit_kind"/>
                            <field name="editorial_level"/>
                            <field name="gesture"/>
                        </group>
                        <group string="Who made it">
                            <field name="author_id"/>
                            <field name="author_kind"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                    <group string="How it points">
                        <field name="prefix"/>
                        <field name="quote"/>
                        <field name="suffix"/>
                        <label for="start_pos" string="Offsets"/>
                        <div>
                            <field name="start_pos" class="oe_inline"/>
                            <span class="mx-1">–</span>
                            <field name="end_pos" class="oe_inline"/>
                        </div>
                    </group>
                    <group string="Body">
                        <field name="body" nolabel="1"/>
                    </group>
                    <group string="Ink" invisible="not ink">
                        <field name="ink" nolabel="1" widget="json"/>
                    </group>
                    <field name="child_ids" nolabel="1" readonly="1">
                        <list string="Replies">
                            <field name="author_id"/>
                            <field name="motivation"/>
                            <field name="body"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_markup_mark_search" model="ir.ui.view">
        <field name="name">markup.mark.search</field>
        <field name="model">markup.mark</field>
        <field name="arch" type="xml">
            <search string="Marks">
                <field name="quote"/>
                <field name="body"/>
                <field name="res_model"/>
                <field name="author_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="orphaned" string="Lost their passage"
                        domain="[('state', '=', 'orphaned')]"/>
                <filter name="suggested_edits" string="Suggested edits"
                        domain="[('motivation', '=', 'editing')]"/>
                <separator/>
                <filter name="by_agent" string="Made by an agent"
                        domain="[('author_kind', '=', 'agent')]"/>
                <group>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'res_model'}"/>
                    <filter name="group_motivation" string="Motivation"
                            context="{'group_by': 'motivation'}"/>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_author" string="Author"
                            context="{'group_by': 'author_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_markup_mark" model="ir.actions.act_window">
        <field name="name">Marks</field>
        <field name="res_model">markup.mark</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_markup_mark_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No marks yet</p>
            <p>
                A mark is a highlight, a note, a question or a suggested edit on
                a passage of a record's text. Marks are made where the text is
                read, not here.
            </p>
        </field>
    </record>

    <menuitem id="menu_markup_mark"
              name="Marks"
              parent="base.menu_custom"
              action="action_markup_mark"
              sequence="95"/>

</odoo>
