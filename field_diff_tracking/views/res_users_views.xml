<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_simple_modif_markup" model="ir.ui.view">
        <field name="name">res.users.preferences.form.markup</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="markup_label_style" readonly="0"/>
            </xpath>
        </field>
    </record>

</odoo>
